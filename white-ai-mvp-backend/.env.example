GEMINI_API_KEY=configure_in_host_secrets_only
GEMINI_MODEL=gemini-2.5-flash

# Razorpay: add these only in Replit/hosting Secrets, never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Informational flag only. Crypto checkout remains disabled in this starter.
CRYPTO_PROVIDER_ENABLED=false
